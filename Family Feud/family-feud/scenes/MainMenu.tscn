[node name="Body" type="Label" parent="HelpOverlay/Center/Panel/Margin/VBox" unique_id=2127838913]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "RUNNING THE SHOW

•  One question is shown at a time with its answers hidden. Click an answer card when a team guesses it right: the points go to the answering team and the turn passes.
•  WRONG ANSWER  ✖  gives a strike and stamps a huge ✖ over the board. Three strikes in a row pass the turn. The ANSWERING buttons hand the turn over by hand.
•  END ROUND closes the board early. REVEAL ONE  ▶  then flips the leftovers one at a time. Between boards a score panel shows both teams' totals - press NEXT QUESTION  ▶  (or SEE RESULTS  ▶  on the last one) to continue.
•  The highest total after the last board wins. If the totals are level, the tie-breaker board decides it.

BEFORE YOU START

•  START A GAME opens Game Setup: tick the questions to play, rename the teams and change the rules. Those are saved for next time.
•  ESC anywhere inside the game brings the setup panel back up."
autowrap_mode = 3

