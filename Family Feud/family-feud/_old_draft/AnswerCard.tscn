[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/answer_card.gd" id="1_script"]

[node name="AnswerCard" type="PanelContainer"]
custom_minimum_size = Vector2(300, 120)
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 15
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 15

[node name="VBox" type="VBoxContainer" parent="Margin"]

[node name="Number" type="Label" parent="Margin/VBox"]
text = "1"
horizontal_alignment = 1

[node name="Answer" type="Label" parent="Margin/VBox"]
text = "????????"
theme_override_font_sizes/font_size = 28
horizontal_alignment = 1

[node name="Points" type="Label" parent="Margin/VBox"]
text = ""
theme_override_font_sizes/font_size = 22
horizontal_alignment = 1

[node name="Button" type="Button" parent="."]
layout_mode = 2
flat = true